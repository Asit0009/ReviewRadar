# Optional. By default the app calls the API on its own origin at /api/v1:
#  - production: FastAPI serves both the React build and the API
#  - development: the Vite dev server proxies /api to http://127.0.0.1:8000
# Set this only to use an API on another host (the backend must then allow this origin in CORS_ORIGINS).
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
