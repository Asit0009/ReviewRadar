# ReviewPulse environment configuration. Copy this file to .env and fill in what you need.
# .env is ignored by git. Never commit real keys.

# --- Assistant (Google Gemini) ---------------------------------------------------
# Without a key the assistant still returns database numbers and similar reviews,
# but no written answer, and says so. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change over time. If you get "model is no longer available", list the models your key can use
# (GET https://generativelanguage.googleapis.com/v1beta/models, header x-goog-api-key) and set GEMINI_MODEL.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25
# Reviews less similar to the question than this (cosine, 0 to 1) are not used as evidence.
# 0.40 was chosen by looking at real scores: matching reviews score 0.5 to 0.8, unrelated questions stay below 0.4.
RETRIEVAL_MIN_SCORE=0.40

# --- API server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Browser origins allowed to call the API from another address. Only the Vite dev server
# needs this; the production build is served by the API itself (same origin, no CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Folder with the built React app (npm run build in frontend/). Default: frontend/dist
# FRONTEND_DIST_DIR=

# --- Data acquisition ------------------------------------------------------------
# Reviews kept per category, sampled from many places in each source file.
DATA_LIMIT_PER_CATEGORY=3000
# Product metadata matches reviews poorly with spread sampling, so it is skipped by default.
META_LIMIT_PER_CATEGORY=0
# Optional: comma-separated category names to use instead of the default ten.
# REVIEWPULSE_CATEGORIES=Electronics,Home_and_Kitchen
